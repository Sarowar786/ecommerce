{
  "name": "backend-nodejs-prisma-starter-kit",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "prisma-push": "npx prisma generate && npx prisma db push",
    "generate": "ts-node generate-module.ts",
    "generate:module": "ts-node generate-module.ts"
  },
  "keywords": [
    "web developer",
    "full stack developer",
    "backend developer",
    "software engineer",
    "backend starter"
  ],
  "author": "Shourav Paul",
  "license": "ISC",
  "description": "",
